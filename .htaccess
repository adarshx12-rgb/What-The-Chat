# Apache hosting at the domain root; requires AllowOverride FileInfo (and
# mod_headers for the security headers below).
# Local error documents preserve the original error status (no external redirect).
ErrorDocument 404 /404.html
ErrorDocument 500 /500.html

# Security headers. Keep in sync with _headers (Cloudflare Pages / Netlify).
# A full Content-Security-Policy and HSTS are added once the domain is live.
<IfModule mod_headers.c>
  Header always set X-Frame-Options "DENY"
  Header always set Content-Security-Policy "frame-ancestors 'none'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), usb=(), serial=(), bluetooth=()"
</IfModule>
