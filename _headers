# Security headers for Cloudflare Pages / Netlify. Keep in sync with .htaccess.
# A full Content-Security-Policy and HSTS are added once the domain is live.
/*
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), usb=(), serial=(), bluetooth=()
